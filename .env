# Discord application credentials
DISCORD_TOKEN=
CLIENT_ID=1568966401568411690
# Optional: register commands only in one Discord server (faster updates)
GUILD_ID=
# Automatically detected from Discord application owner when possible; only these IDs can approve/revoke SSH accounts
OWNER_IDS=1531978712541691964
# Optional private log channel for access approvals and endpoint changes
LOG_CHANNEL_ID=

# SSH service on the VPS running this bot
SSH_PORT=98
# Optional static public IPv4 override; leave blank for automatic detection
PUBLIC_IPV4=

# Pinggy TCP fallback is used when no public IPv4 is detected or SSH is loopback-only
ENABLE_PINGGY=true
# Set true to force Pinggy even when IPv4 exists (for NAT/provider firewalls)
FORCE_PINGGY=false
# Optional Pinggy Pro token; keep it private. Free tunnels are time-limited.
PINGGY_TOKEN=

# Set true only after confirming that this is your VPS or you are authorized to administer it
PUBLIC_SSH_ACK=true
# Installer sets these paths automatically
SSH_HELPER_PATH=/usr/local/sbin/rgnodes-vm-ssh-user
STATE_FILE=/var/lib/rgnodesbot/state/access.json
